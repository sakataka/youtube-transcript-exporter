{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YouTube AI Brief",
  "version": "0.1.0",
  "identifier": "com.local.youtube-ai-brief",
  "build": {
    "beforeDevCommand": "bunx vite --host 127.0.0.1 --port 1420",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "YouTube AI Brief",
        "width": 1440,
        "height": 1040,
        "minWidth": 1100,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns"]
  }
}
