{
  "name": "youtube-ai-brief",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.1",
  "scripts": {
    "build": "vite build",
    "web": "bun run build && cargo run --manifest-path server/Cargo.toml --bin youtube-ai-brief-web",
    "web:server": "cargo run --manifest-path server/Cargo.toml --bin youtube-ai-brief-web",
    "web:build": "bun run build && cargo build --manifest-path server/Cargo.toml --bin youtube-ai-brief-web",
    "test:frontend": "bun test src/*.test.ts",
    "test": "cargo test --manifest-path server/Cargo.toml",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.41.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  }
}
